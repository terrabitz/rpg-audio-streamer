# Start the container, retrieve setup_code from its logs, and open the app.
# Keep the data volume: it contains the admin account, signing key, and uploads.

# Optional first-run bootstrap. Ignored after the admin account exists.
# ROOT_USERNAME=admin
# ROOT_PASSWORD=<initial password, at least 12 characters>
# Or supply an Argon2id hash instead of ROOT_PASSWORD:
# ROOT_PASSWORD_HASH=<Argon2id hash>

# Optional deployment settings.
# TOKEN_SECRET=<random signing secret>
# DISCORD_STREAMING_ENABLED=true
# DISCORD_STREAMING_BOT_TOKEN=<Discord bot token>

# CORS_ORIGINS=https://audio.example.com
# PORT=8080
# LOG_FORMAT=json
# LOG_LEVEL=info
# UPLOAD_DIR=./uploads
# DEV_MODE=false
