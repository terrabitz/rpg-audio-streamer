{
	"name": "RPG Audio Streamer",
	"build": {
		"dockerfile": "Dockerfile",
		"context": ".."
	},
	"remoteUser": "vscode",
	"postCreateCommand": "go mod download && npm --prefix ui ci",
	"waitFor": "postCreateCommand",
	"forwardPorts": [
		5173,
		8080
	],
	"portsAttributes": {
		"5173": { "label": "Vite" },
		"8080": { "label": "Go API" }
	}
}