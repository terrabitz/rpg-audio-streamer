{
	"name": "RPG Audio Streamer",
	"build": {
		"dockerfile": "Dockerfile",
		"context": ".."
	},
	"features": {
		"ghcr.io/devcontainers/features/docker-outside-of-docker:1.10.3": {
			"moby": false
		}
	},
	"workspaceMount": "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind",
	"workspaceFolder": "${localWorkspaceFolder}",
	"runArgs": ["--add-host=host.docker.internal:host-gateway"],
	"containerEnv": {
		"EXAMPLES_BASE_URL": "http://host.docker.internal:8080"
	},
	"remoteUser": "vscode",
	"postCreateCommand": "go mod download && npm --prefix ui ci",
	"waitFor": "postCreateCommand",
	"forwardPorts": [
		5173,
		8080
	],
	"portsAttributes": {
		"5173": { "label": "Vite" },
		"8080": { "label": "Go API" }
	}
}