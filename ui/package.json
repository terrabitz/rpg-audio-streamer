{
  "name": "ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "build-dev": "vite build -h",
    "generate-api-client": "openapi-ts",
    "generate-docs": "redocly build-docs ../openapi.yaml --output public/docs/index.html"
  },
  "dependencies": {
    "@hey-api/client-fetch": "^0.13.1",
    "@mdi/js": "^7.4.47",
    "axios": "^1.20.0",
    "hls.js": "^1.7.2",
    "lodash.debounce": "^4.0.8",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.42",
    "vue-axios": "^3.6.0",
    "vue-router": "^5.3.1",
    "vuetify": "^4.2.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@redocly/cli": "^2.51.1",
    "@tsconfig/node22": "^22.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/lodash.debounce": "^4.0.9",
    "@types/node": "^26.4.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/eslint-plugin": "1.6.27",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.6",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  }
}
